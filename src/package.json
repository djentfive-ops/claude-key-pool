{
  "name": "claude-key-pool",
  "productName": "Claude 키 묶음",
  "version": "1.1.0",
  "description": "여러 Claude 계정의 API 크레딧 키를 주소 하나로 묶어 쓰는 앱",
  "author": "OVIS Studio",
  "main": "bootstrap.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "studio.ovis.claudekeypool",
    "productName": "Claude 키 묶음",
    "files": [
      "bootstrap.js",
      "core/**"
    ],
    "win": {
      "target": "dir",
      "icon": "core/assets/icon.ico",
      "signAndEditExecutable": false,
      "executableName": "ClaudeKeyPool"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "compression": "maximum",
    "directories": {
      "app": "."
    }
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "pretendard": "^1.3.9"
  }
}